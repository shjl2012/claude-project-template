{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_openspec_active.py",
                        "timeout": 10,
                        "statusMessage": "Checking for an active OpenSpec change..."
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_git_branch.py",
                        "timeout": 10,
                        "statusMessage": "Checking git branch workflow..."
                    }
                ]
            },
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_git_branch.py",
                        "timeout": 10,
                        "statusMessage": "Checking git branch workflow..."
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_code_quality.py",
                        "timeout": 30,
                        "statusMessage": "Checking code quality checklist..."
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_git_branch.py",
                        "timeout": 10,
                        "statusMessage": "Checking git branch workflow..."
                    }
                ]
            }
        ]
    }
}
